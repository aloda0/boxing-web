Options -MultiViews -Indexes
DirectorySlash Off
RewriteEngine On

# Remove trailing slash: /team/ → /team
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Static assets — serve directly
RewriteRule ^_next/ - [L]
RewriteRule ^favicon\. - [L]
RewriteRule ^robots\.txt$ - [L]
RewriteRule ^sitemap\.xml$ - [L]

# Existing files — serve directly
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Clean URLs: page.html has priority over page/ directory
# Fixes: old build left page/index.html, new build uses page.html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Existing directories — serve directly (RSC payload folders)
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 404 fallback
ErrorDocument 404 /404.html

# Cache control
# HTML — никогда не кешировать (страницы меняются при деплое)
<FilesMatch "\.(html|txt)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>

# Next.js статические ассеты — кешировать вечно (имена содержат хеш)
<FilesMatch "^_next/static/">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
