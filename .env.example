# --- Sanity (обязательно для работы Studio и контента на сайте) ---
#
# Где взять Project ID и dataset:
#   https://sanity.io/manage → выберите проект → Settings → API
#   Project ID — строка в блоке «Project ID»
#   Dataset — в разделе «Datasets» (часто называется production)
#
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# То же значение, что и NEXT_PUBLIC_SANITY_PROJECT_ID, если используете CLI `sanity`
# без загрузки .env.local (опционально)
# SANITY_STUDIO_PROJECT_ID=

# Основной сайт для посетителей (без слэша в конце)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Админка на поддомене (в продакшене) ---
ADMIN_HOSTNAME=
NEXT_PUBLIC_ADMIN_URL=

# Только для scripts/seed.mjs — токен с правами Editor
# SANITY_API_TOKEN=
